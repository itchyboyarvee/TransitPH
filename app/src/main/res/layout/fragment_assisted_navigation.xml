<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top Header & Language Selector Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_assisted_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assisted Navigation"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Language Spinner Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Display Language:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/sp_assisted_language"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:drawable/btn_dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_active_language_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Commuter phrases &amp; instructions in English, Filipino, and Bikol."
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <!-- Category Filter Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_filter_all"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_light"
                        android:text="All"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_directions"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_light"
                        android:text="Directions"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_transport"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_light"
                        android:text="Transport"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_fare"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="@color/primary_light"
                        android:text="Fare"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_filter_getting_off"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/primary_light"
                        android:text="Getting Off"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Subheader -->
    <TextView
        android:id="@+id/tv_category_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="COMMUTER PHRASES (12)"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/card_assisted_header"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Phrases RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_assisted_phrases"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_category_header"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
